# ----------------------------------------------------------------------------
# LOCAL DEVELOPMENT ONLY.
#
# None of this exists at scoring time: the harness sets MODEL_ENDPOINT, MODEL_NAME and
# MODEL_TOKEN itself, every vendor API is refused by the audited proxy, and the
# submission image needs no key and must never contain one.
#
# `.env` is gitignored. `.env.example` is the committed template.
#
# HOW THE SWITCH WORKS. Each provider keeps its own variables, so several keys live here
# at once and changing provider is ONE line:
#
#     QFBENCH_DEV_PROVIDER=NEMOTRON   ->  QFBENCH_NEMOTRON_API_KEY / _BASE_URL / _MODEL
#     QFBENCH_DEV_PROVIDER=GEMINI     ->  QFBENCH_GEMINI_API_KEY   / _BASE_URL / _MODEL
#
# Anything the selected provider does not define falls back to the QFBENCH_DEV_* names.
# ----------------------------------------------------------------------------

QFBENCH_DEV_PROVIDER=NEMOTRON

# --- NEMOTRON: the House model itself, via OpenRouter -----------------------
# `nvidia/nemotron-3-super-120b-a12b` is the model id the scoring route runs, as named in
# the Track 1 starter pack and declared in our submission descriptor.
#
# WHY DEVELOP AGAINST THIS. The dev-phase run measured the gap directly. On tasks whose
# solutions fit well inside the 4,000-token response cap -- where nothing is truncated and
# the only variable is the model -- Gemini Flash-Lite passed 46.8% locally while the House
# model scored 8.5%. Every local pass rate, every A/B and every judgement about what helps
# was made against a model roughly five times stronger than the one that grades us.
#
# Free tier: 20 requests/minute, 1,000 requests/day once the account has bought $10 of
# credit at any point. A full 86-unit sweep is around 480 requests at our current pace.
# Key: https://openrouter.ai/keys
QFBENCH_NEMOTRON_API_KEY=<your key>
QFBENCH_NEMOTRON_BASE_URL=https://openrouter.ai/api/v1
QFBENCH_NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Same key and endpoint, spending paid credit instead of the free allowance. Worth switching
# to if the free variant is throttled at peak or rotated out; measured from our own token
# counts, a full roster sweep costs about $0.55.
# QFBENCH_NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b

# --- GEMINI: fast and cheap, for exercising the machinery -------------------
# Keep for work where what matters is that a model answers at all rather than how well:
# the assembly path, the validator, the repair loop. NOT for judging whether a change
# helps -- it is far stronger than the House model and will flatter anything measured on it.
QFBENCH_GEMINI_API_KEY=<your key>
QFBENCH_GEMINI_API_KEY2=<second key, tried when the first is refused for quota>
QFBENCH_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
QFBENCH_GEMINI_MODEL=gemini-3.5-flash-lite

# --- Anthropic (occasional ceiling checks) ----------------------------------
# When a unit fails everywhere, one run against a strong model separates "the loop is
# broken" from "the model was not capable enough".
# QFBENCH_DEV_PROVIDER=ANTHROPIC
# QFBENCH_ANTHROPIC_API_KEY=<your key>
# QFBENCH_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# QFBENCH_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Local open model via Ollama --------------------------------------------
# No key needed, but the variable must be non-empty for dev mode to engage.
# QFBENCH_DEV_PROVIDER=OLLAMA
# QFBENCH_OLLAMA_API_KEY=<your key>
# QFBENCH_OLLAMA_BASE_URL=http://localhost:11434/v1
# QFBENCH_OLLAMA_MODEL=qwen2.5-coder:7b

# --- No network at all ------------------------------------------------------
# Canned responses, no spend, deterministic. Used by the test suite.
# QFBENCH_FAKE_LLM=1

# --- Measurement switches ---------------------------------------------------
# A/B the two prompt additions. Both are hypotheses, and both were tuned against Gemini,
# so both are worth re-measuring now that dev matches scoring.
# QFBENCH_NO_INVARIANT_GUIDANCE=1
# QFBENCH_NO_INPUT_PREVIEW=1

# Sent as `seed` on every request when set; the client withdraws it on a 400. Gemini refuses
# the field outright. Whether OpenRouter honours it is untested, and it matters twice: without
# it no before/after comparison is reliable, and the competition re-runs submissions to check
# they reproduce.
# QFBENCH_MODEL_SEED=0
