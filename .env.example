# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT ONLY.
#
# None of this exists at scoring time: the harness sets MODEL_ENDPOINT/MODEL_NAME and
# EVERY vendor API (Google, Anthropic, OpenAI) is refused by the audited proxy. The
# submission image needs no key and must never contain one.
# `.env` is gitignored; this file is the committed template.
#
# The client speaks OpenAI-compatible /chat/completions. That is a PROTOCOL, not a
# vendor -- so the dev provider is pure configuration. Uncomment ONE block.
# ---------------------------------------------------------------------------

# --- Google Gemini (recommended for dev: generous free tier) ----------------
# Free tier is the right default because Tier-2 sweeps are 87 units x many calls x
# many iterations -- volume, not single-call quality, is the binding constraint.
# Flash-Lite is also closer in capability to the house OPEN model than a frontier
# model would be, which reduces over-tuning risk. Key: https://aistudio.google.com/apikey
QFBENCH_DEV_API_KEY=
QFBENCH_DEV_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
QFBENCH_DEV_MODEL=gemini-3.5-flash-lite

# --- Anthropic (good for occasional CEILING CHECKS) -------------------------
# Use sparingly: when a unit fails, one run against a strong model tells you whether
# the LOOP is broken or the MODEL was too weak. Don't spend limited credits on sweeps.
# QFBENCH_DEV_API_KEY=sk-ant-...
# QFBENCH_DEV_BASE_URL=https://api.anthropic.com/v1
# QFBENCH_DEV_MODEL=claude-haiku-4-5-20251001

# --- OpenAI -----------------------------------------------------------------
# QFBENCH_DEV_API_KEY=sk-...
# QFBENCH_DEV_BASE_URL=https://api.openai.com/v1
# QFBENCH_DEV_MODEL=gpt-4o-mini

# --- Local open model via Ollama (closest analogue to the house model) -------
# No key needed, but the variable must be non-empty for dev mode to engage.
# QFBENCH_DEV_API_KEY=ollama
# QFBENCH_DEV_BASE_URL=http://localhost:11434/v1
# QFBENCH_DEV_MODEL=qwen2.5-coder:7b

# Run the loop with canned responses -- no network, no spend, deterministic.
# QFBENCH_FAKE_LLM=1
